{
  "name": "nextplay-task-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm test:repository && pnpm test:db && pnpm test:e2e",
    "test:repository": "node --test tests/repository.test.mjs",
    "test:db": "node --test tests/database.test.mjs",
    "test:e2e": "playwright test",
    "test:cloud": "node --env-file-if-exists=.env tests/cloud-smoke.mjs",
    "format": "prettier --write src tests *.ts *.json *.yaml"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.49.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
